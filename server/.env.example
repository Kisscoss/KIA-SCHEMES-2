# Backend (server/.env) — never commit real secrets.
# Neon Postgres connection string (Neon console → Connect → pooled connection).
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require"
# OpenRouter key for AI generation (server-side only).
OPENROUTER_API_KEY=""
# Optional override (default openrouter/free).
OPENROUTER_MODEL=openrouter/free
PORT=4000

# Neon Auth (Managed Better Auth) — used to verify session JWTs on /api/schemes.
# JWKS endpoint from Neon Console → Auth → Configuration (…/auth/.well-known/jwks.json).
AUTH_JWKS_URL=""
# Optional: leave empty to verify signature only (recommended unless you pin the issuer).
AUTH_ISSUER=""
# Comma-separated browser origins allowed by CORS (empty = no cross-origin CORS).
# Example when frontend and API are on different hosts:
# CORS_ORIGIN="https://your-app.example.com"
CORS_ORIGIN=""
# Set to 1 when running behind a reverse proxy so rate limits see real client IPs.
TRUST_PROXY=0
