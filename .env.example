# Copy to .env and fill in real values. Never commit .env.
# Optional: only needed if the API is hosted separately from the frontend.
# In dev, Vite proxies /api to http://localhost:4000 (see vite.config.ts).
# In prod, serve dist/ from the API or set this to your API origin.
VITE_API_URL=""

OPENROUTER_API_KEY="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"
# OpenRouter model for scheme generation (default openrouter/free — Free Models Router).
OPENROUTER_MODEL=openrouter/free